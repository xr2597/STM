--cpu Cortex-M3
"out\startup_stm32f103xb.o"
"out\main.o"
"out\gpio.o"
"out\tim.o"
"out\stm32f1xx_it.o"
"out\stm32f1xx_hal_msp.o"
"out\stm32f1xx_hal_gpio_ex.o"
"out\stm32f1xx_hal_tim.o"
"out\stm32f1xx_hal_tim_ex.o"
"out\stm32f1xx_hal.o"
"out\stm32f1xx_hal_rcc.o"
"out\stm32f1xx_hal_rcc_ex.o"
"out\stm32f1xx_hal_gpio.o"
"out\stm32f1xx_hal_dma.o"
"out\stm32f1xx_hal_cortex.o"
"out\stm32f1xx_hal_pwr.o"
"out\stm32f1xx_hal_flash.o"
"out\stm32f1xx_hal_flash_ex.o"
"out\stm32f1xx_hal_exti.o"
"out\system_stm32f1xx.o"
--strict --scatter "out\out.sct"
--summary_stderr --info summarysizes --map --load_addr_map_info --xref --callgraph --symbols
--info sizes --info totals --info unused --info veneers
--list "out.map" -o out\out.axf